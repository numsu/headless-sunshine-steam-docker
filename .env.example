SUNSHINE_CORS_ORIGIN=https://192.168.1.100:47990
NVIDIA_GPU_ID=0
GAMES_DIR=./data/games
# Host dir holding the NVIDIA NGX loader (nvngx.dll, _nvngx.dll), seeded
# into Proton prefixes at container boot. Find yours with:
# dpkg -L libnvidia-gl | grep 'nvidia/wine'. Must exist (mkdir -p an empty
# dir to disable seeding).
NVIDIA_WINE_DIR=/usr/lib/x86_64-linux-gnu/nvidia/wine
